S_0x7ff5e8704160 .scope module, "yes_gate_tb" "yes_gate_tb" 2 3;
 .timescale 0 0;
v0x7ff5e9814410_0 .var "a", 0 0;
v0x7ff5e98144c0_0 .net "y", 0 0, L_0x7ff5e9814570;  1 drivers
S_0x7ff5e9804080 .scope module, "uut" "yes_gate" 2 8, 3 3 0, S_0x7ff5e8704160;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "y";
L_0x7ff5e9814570 .functor BUFZ 1, v0x7ff5e9814410_0, C4<0>, C4<0>, C4<0>;
v0x7ff5e9804290_0 .net "a", 0 0, v0x7ff5e9814410_0;  1 drivers
v0x7ff5e9814340_0 .net "y", 0 0, L_0x7ff5e9814570;  alias, 1 drivers
    .scope S_0x7ff5e8704160;
T_0 ;
    %vpi_call 2 15 "$dumpfile", "yes_gate.vcd" {0 0 0};
    %vpi_call 2 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x7ff5e8704160 {0 0 0};
    %vpi_call 2 18 "$display", "A B | Y" {0 0 0};
    %vpi_call 2 19 "$display", "---------" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x7ff5e9814410_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 21 "$display", "%b | %b", v0x7ff5e9814410_0, v0x7ff5e98144c0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x7ff5e9814410_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 23 "$display", "%b | %b", v0x7ff5e9814410_0, v0x7ff5e98144c0_0 {0 0 0};
    %vpi_call 2 25 "$finish" {0 0 0};
    %end;
    .thread T_0;
